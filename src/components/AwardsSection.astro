---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { awards } from '@/data/awards';
---

<section class="page-container" aria-labelledby="awards-heading">
  <SectionHeading title="Recognition" id="awards-heading" icon="award" />
  <div class="grid-2 grid grid-cols-2 gap-5">
    {awards.map((award) => (
      <div class="card card-award">
        <p class="text-[13px] font-semibold text-amber m-0 mb-3">{award.date}</p>
        <h4 class="text-lg font-bold m-0 mb-1 text-ink">{award.title}</h4>
        <p class="text-[13px] font-semibold m-0 mb-2.5 text-muted-light">{award.organization}</p>
        <p class="text-[13px] leading-normal m-0 text-muted">{award.description}</p>
      </div>
    ))}
  </div>
</section>
