---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { careerPath } from '@/data/highlights';
---

<section class="page-container pt-12" aria-labelledby="career-heading">
  <SectionHeading title="Career Evolution" id="career-heading" />
  <div class="flex items-center gap-2 flex-wrap">
    {careerPath.map((step, i) => (
      <span class="inline-flex items-center gap-2 whitespace-nowrap">
        {i > 0 && (
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        )}
        <span class:list={['pill', i === careerPath.length - 1 && 'pill-active']}>{step}</span>
      </span>
    ))}
  </div>
</section>
