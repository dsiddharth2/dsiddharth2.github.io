---
import { site } from '@/config/site';
---

<section id="contact" class="page-container pt-20 pb-20" aria-labelledby="contact-heading">
  <div class="bg-ink rounded-[20px] px-12 py-14 flex items-center justify-between gap-10 flex-wrap">
    <div class="contact-inner flex items-center justify-between gap-10 flex-wrap w-full">
      <div>
        <h2 id="contact-heading" class="text-[clamp(32px,4vw,44px)] font-bold m-0 text-white tracking-tight leading-tight">
          LET'S WORK<br />TOGETHER
        </h2>
      </div>
      <div class="contact-actions flex flex-col gap-3 items-end">
        <a href={`mailto:${site.email}`} class="btn-cta">Let's Talk</a>
        <div class="flex gap-2.5">
          <a
            href={site.medium}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="Medium profile"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff" aria-hidden="true">
              <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"></path>
            </svg>
          </a>
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="LinkedIn profile"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="GitHub profile"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
