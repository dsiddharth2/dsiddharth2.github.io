---
import { resolvedDeployments } from '@/data/deployments';

const items = resolvedDeployments();
---

<section class="deployments-section" aria-labelledby="deployments-heading">
  <div class="page-container section-padding">
    <p class="section-eyebrow" data-reveal>Selected Work</p>
    <h2 id="deployments-heading" class="section-title deployments-title" data-reveal data-reveal-delay="1">
      Ambiguous problem in,<br />production system out.
    </h2>

    <blockquote class="deployments-quote" data-reveal data-reveal-delay="1">
      <p>“Chosen by team for client management, mentorship, and independent releases.”</p>
      <cite>Leadership Excellence Award · Apra Labs · Nov 2024</cite>
    </blockquote>

    <div class="deployments-grid">
      {items.map((item, index) => (
        <article class="deployment-card" data-reveal data-reveal-delay={String((index % 3) + 1)}>
          <p class="deployment-flavour">{item.flavour}</p>
          <h3 class="deployment-title">{item.product.title}</h3>

          <dl class="deployment-facts">
            <dt>Context</dt>
            <dd>{item.customer}</dd>
            <dt>Constraint</dt>
            <dd>{item.constraint}</dd>
            <dt>What I built</dt>
            <dd>{item.whatIDid}</dd>
          </dl>

          <div class="deployment-card-footer">
            <p class="deployment-outcome">
              <span class="deployment-outcome-metric">{item.outcome.metric}</span>
              <span class="deployment-outcome-label">{item.outcome.label}</span>
            </p>
            <a href={item.href} class="deployment-view-more">
              Read the deployment
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="M12 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <a href="/how-i-work" class="deployments-more" data-reveal>
      How I work with customers
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"></path>
        <path d="M12 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>
</section>
