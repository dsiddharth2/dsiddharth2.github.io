---
import type { ExperienceEntry } from '@/data/experience';

interface Props {
  entry: ExperienceEntry;
  reveal?: boolean;
  /** Timeline mode — drop the bullet lists and callout, keep the headline facts. */
  compact?: boolean;
}

const { entry, reveal = false, compact = false } = Astro.props;
---

<article class:list={['experience-entry', compact && 'experience-entry--compact']} data-reveal={reveal || undefined}>
  <div class="experience-row">
    <div class="experience-sidebar">
      <h3 class="experience-company">{entry.company}</h3>
      {entry.role && <p class="experience-role">{entry.role}</p>}
      <p class="experience-period">{entry.period}</p>
      {entry.metrics && (
        <div class="experience-metrics">
          {entry.metrics.map((metric) => (
            <div class="experience-metric">
              <span class="experience-metric-value">{metric.value}</span>
              <span class="experience-metric-label">{metric.label}</span>
            </div>
          ))}
        </div>
      )}
    </div>

    <div class="experience-body">
      {entry.earlierEntries ? (
        <div>
          {entry.earlierEntries.map((item) => (
            <div class="experience-earlier-item">
              <div class="experience-earlier-header">
                <p class="experience-earlier-company">{item.company}</p>
                <span class="experience-earlier-role">{item.role}</span>
              </div>
              <p class="experience-earlier-summary">{item.summary}</p>
            </div>
          ))}
        </div>
      ) : (
        <>
          <p class="experience-summary">{entry.summary}</p>
          {!compact && entry.items && (
            <ul class="experience-list">
              {entry.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {!compact && entry.columns?.map((column) => (
            <div>
              <p class="experience-subheading">{column.title}</p>
              <ul class="experience-list">
                {column.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
          {!compact && entry.extra && (
            <div class="experience-callout">
              <p class="experience-callout-title">{entry.extra.title}</p>
              <p class="experience-callout-body">{entry.extra.description}</p>
            </div>
          )}
        </>
      )}
      <a href={`/experience/${entry.id}`} class="experience-view-more">
        View More
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="M12 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</article>
