---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ExperienceCard from '@/components/ExperienceCard.astro';
import { experience } from '@/data/experience';

const detailed = experience.filter((e) => !e.compact);
const compact = experience.filter((e) => e.compact);
---

<section id="experience" class="page-container pt-12" aria-labelledby="experience-heading">
  <SectionHeading title="What Changed Because I Was There" id="experience-heading" icon="briefcase" />
  <p class="text-base text-muted-light m-0 mb-10 max-w-[600px]">
    Problem → Ownership → Technical Execution → Business Outcome. Every role, the same pattern.
  </p>

  <div class="flex flex-col gap-6">
    {detailed.map((entry) => (
      <ExperienceCard entry={entry} />
    ))}
    <div class="grid-2 grid grid-cols-2 gap-5">
      {compact.map((entry) => (
        <ExperienceCard entry={entry} />
      ))}
    </div>
  </div>
</section>
