---
import { site } from '@/config/site';
import { assetUrl } from '@/utils/assets';

const profileImage = assetUrl('images/profile.jpg');
---

<section id="about" class="hero-dark">
  <div class="hero-inner">
    <div class="hero-content">
      <p class="hero-kicker">Associate Architect · AI & Cloud Systems</p>
      <h1 class="hero-title">I build systems<br />that run<br />businesses.</h1>
      <p class="hero-lede">
        From 0-to-1 products to enterprise platforms serving 300+ facilities — I take ambiguous problems, architect the system, hire the team, and ship.
      </p>
      <div class="hero-actions">
        <a href={`mailto:${site.email}`} class="btn-hero-primary">Contact Me</a>
        <a href="#video-resume" class="btn-hero-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z"></path>
          </svg>
          Video Resume
        </a>
      </div>
    </div>

    <div class="hero-photo-wrap">
      <div class="hero-photo">
        <img src={profileImage} alt={site.name} width="340" height="340" />
      </div>
      <div class="hero-badge" aria-label="12+ years shipping">
        <p class="hero-badge-value">12+</p>
        <p class="hero-badge-label">years shipping</p>
      </div>
    </div>
  </div>
</section>

<section id="video-resume" class="hidden" aria-label="Video resume">
  <p>Video resume coming soon.</p>
</section>
