---
import { site } from '@/config/site';
import { assetUrl } from '@/utils/assets';

const profileImage = assetUrl('images/profile.jpg');
---

<section class="hero-dark">
  <div class="hero-inner">
    <div class="hero-content">
      <p class="hero-kicker">Associate Architect · Applied AI</p>
      <h1 class="hero-title">Production AI systems<br />for complex,<br />real-world problems.</h1>
      <p class="hero-lede">
        I work the full path from ambiguous problem to production — understanding the problem,
        designing the system, building it, deploying it, and iterating against real users and real
        constraints.
      </p>
      <div class="hero-actions">
        <a href="#case-studies" class="btn-hero-primary">View my work</a>
        <a href="/resume" class="btn-hero-secondary" data-resume-modal>Resume</a>
      </div>
      <div class="hero-links">
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="hero-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          GitHub
          <span class="sr-only">(opens in a new tab)</span>
        </a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="hero-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
          LinkedIn
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>
    </div>

    <div class="hero-photo-wrap">
      <div class="hero-photo">
        <img src={profileImage} alt={site.name} width="340" height="340" />
      </div>
      <div class="hero-badge" aria-label="12+ years shipping">
        <p class="hero-badge-value">12+</p>
        <p class="hero-badge-label">years shipping</p>
      </div>
    </div>
  </div>
</section>
