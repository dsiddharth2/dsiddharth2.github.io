---
import { site } from '@/config/site';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isAbout = pathname.startsWith('/about');

const sectionHref = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="nav-brand">
      <div class="nav-logo" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m13 2-2 14h5L9 22l2-14H6z"></path>
        </svg>
      </div>
      <span class="nav-name">{site.name}</span>
    </a>
    <div class="nav-links">
      {
        isAbout ? (
          <span class="nav-link nav-link--active" aria-current="page">About</span>
        ) : (
          <a href="/about" class="nav-link">About</a>
        )
      }
      <a href={sectionHref('experience')} class="nav-link">Experience</a>
      <a href={sectionHref('products')} class="nav-link">Products</a>
      <a href={sectionHref('contact')} class="nav-cta">Get in Touch</a>
    </div>
  </div>
</nav>
