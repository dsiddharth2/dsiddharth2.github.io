---
import OpenSourceIcon from '@/components/ui/OpenSourceIcon.astro';
import { openSourceProjects } from '@/data/opensource';

interface Props {
  hideIntro?: boolean;
}

const { hideIntro = false } = Astro.props;
---

<section
  id="opensource"
  class:list={['opensource-section', hideIntro && 'opensource-section--page']}
  aria-label={hideIntro ? 'Open source' : undefined}
  aria-labelledby={hideIntro ? undefined : 'opensource-heading'}
>
  <div class="page-container section-padding">
    {!hideIntro && (
      <>
        <p class="section-eyebrow" data-reveal>Open Source</p>
        <h2 id="opensource-heading" class="section-title" data-reveal data-reveal-delay="1">
          Giving back to the community
        </h2>
      </>
    )}
    <div class="opensource-grid">
      {openSourceProjects.map((project, index) => (
        <article class="opensource-card" data-reveal data-reveal-delay={String((index % 2) + 1)}>
          <div class="opensource-card-top">
            <span class="opensource-index">{String(index + 1).padStart(2, '0')}</span>
            <OpenSourceIcon icon={project.icon} />
            <span class="opensource-lang">{project.language}</span>
          </div>
          <h3 class="opensource-title">{project.title}</h3>
          <p class="opensource-subtitle">{project.subtitle}</p>
          <p class="opensource-description">{project.description}</p>
          <div class="opensource-tags">
            {project.tags.map((tag) => (
              <span class="opensource-tag">{tag}</span>
            ))}
          </div>
          <div class="opensource-card-footer">
            <a href={`/opensource/${project.slug}`} class="opensource-view-more">
              View More
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="M12 5l7 7-7 7"></path>
              </svg>
            </a>
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="opensource-github">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"></path>
                <path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
              GitHub
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
