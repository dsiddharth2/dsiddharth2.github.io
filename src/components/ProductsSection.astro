---
import ProductIcon from '@/components/ui/ProductIcon.astro';
import { products } from '@/data/products';
---

<section id="products" class="products-section" aria-labelledby="products-heading">
  <div class="page-container section-padding">
    <p class="section-eyebrow">Products</p>
    <h2 id="products-heading" class="section-title section-title--light">
      Systems I've architected and shipped
    </h2>
    <div class="products-grid">
      {products.map((product) => (
        <article class="product-card">
          <ProductIcon icon={product.icon} />
          <h3 class="product-title">{product.title}</h3>
          <p class="product-subtitle">{product.subtitle}</p>
          <p class="product-description">{product.description}</p>
          <div class="product-tags">
            {product.tags.map((tag) => (
              <span class="product-tag">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
