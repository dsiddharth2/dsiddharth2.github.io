---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
---

<section class="page-container pt-20" aria-labelledby="writing-heading">
  <SectionHeading title="Writing" id="writing-heading" icon="pen" />
  <a
    href={site.medium}
    target="_blank"
    rel="noopener noreferrer"
    class="card-link"
  >
    <svg width="32" height="32" viewBox="0 0 24 24" fill="#1a1a1a" aria-hidden="true">
      <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"></path>
    </svg>
    <div>
      <p class="text-[17px] font-bold m-0 text-ink">@siddharthanantdeshpande</p>
      <p class="text-sm mt-1 m-0 text-muted-light">I write about AI systems, architecture patterns, and engineering leadership →</p>
    </div>
  </a>
</section>
