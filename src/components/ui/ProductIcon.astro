---
import type { ProductIcon as ProductIconName } from '@/data/products';

interface Props {
  icon: ProductIconName;
}

const { icon } = Astro.props;
---

<div class="product-icon" aria-hidden="true">
  {icon === 'graph' && (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2">
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M12 2v4m0 12v4M2 12h4m12 0h4m-2.93-7.07-2.83 2.83m-8.48 8.48-2.83 2.83m0-14.14 2.83 2.83m8.48 8.48 2.83 2.83"></path>
    </svg>
  )}
  {icon === 'chat' && (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  )}
  {icon === 'code' && (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2">
      <path d="M16 18l2-2-2-2"></path>
      <path d="M8 18l-2-2 2-2"></path>
      <path d="M14.5 4l-5 16"></path>
    </svg>
  )}
  {icon === 'cloud' && (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2">
      <path d="M12 2v20M2 12h20"></path>
      <circle cx="12" cy="12" r="10"></circle>
    </svg>
  )}
  {icon === 'performance' && (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2">
      <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
    </svg>
  )}
  {icon === 'search' && (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="M21 21l-4.35-4.35"></path>
    </svg>
  )}
  {icon === 'truck' && (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2">
      <rect x="1" y="3" width="15" height="13"></rect>
      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
      <circle cx="5.5" cy="18.5" r="2.5"></circle>
      <circle cx="18.5" cy="18.5" r="2.5"></circle>
    </svg>
  )}
  {icon === 'analytics' && (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2">
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
    </svg>
  )}
</div>
