---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  markdownPath?: string;
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Header item to highlight; derived from the URL when omitted. */
  active?: NavLabel;
}

import { site, getSiteUrl } from '@/config/site';
import { assetUrl } from '@/utils/assets';
import ResumeDialog from '@/components/ResumeDialog.astro';
import ThemeScript from '@/components/ThemeScript.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import type { NavLabel } from '@/config/nav';
import { THEME_COLORS } from '@/utils/theme';
import '@/styles/global.css';
import '@/styles/site.css';

const {
  title = site.title,
  description = site.description,
  image = getSiteUrl('/images/profile.jpg'),
  canonicalPath = '',
  markdownPath,
  ogType = 'website',
  jsonLd,
  active,
} = Astro.props;

const canonicalUrl = getSiteUrl(canonicalPath);
const markdownUrl = markdownPath ? getSiteUrl(markdownPath) : undefined;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const isResumePage = (canonicalPath || Astro.url.pathname).replace(/\/$/, '') === '/resume';
const showChrome = !isResumePage;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.gtagId}`}></script>
    <script
      is:inline
      set:html={`
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '${site.gtagId}');
    `}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta
      name="robots"
      content={isResumePage ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
    />
    <meta name="theme-color" content={THEME_COLORS.dark} />
    <ThemeScript />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <link rel="icon" type="image/png" sizes="48x48" href={assetUrl('favicon-48.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={assetUrl('favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={assetUrl('favicon-16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={assetUrl('apple-touch-icon.png')} />
    <link rel="manifest" href={assetUrl('site.webmanifest')} />
    <link rel="canonical" href={canonicalUrl} />
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={site.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={site.name} />

    <title>{title}</title>

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class:list={[isResumePage && 'resume-page']}>
    {!isResumePage && (
      <a href="#main-content" class="skip-link">Skip to content</a>
    )}
    {showChrome && <SiteHeader active={active} />}
    <slot />
    {showChrome && <SiteFooter markdownPath={markdownPath} />}
    <ResumeDialog standalone={isResumePage} />
  </body>
</html>
