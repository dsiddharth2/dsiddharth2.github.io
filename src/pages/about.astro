---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StackSection from '@/components/home/StackSection.astro';
import { site } from '@/config/site';
import { assetUrl } from '@/utils/assets';
import {
  aboutBio,
  aboutCapabilities,
  aboutDepth,
  aboutEducation,
} from '@/data/about';
import { awards } from '@/data/awards';
import { experience } from '@/data/experience';
import { philosophyStats } from '@/data/philosophy';
import { aboutLede, heroRoles, ownershipLine } from '@/data/hero';
import { aboutPageJsonLd } from '@/utils/seo';

const profileImage = assetUrl('images/profile.jpg');
const aboutRole = heroRoles[0];
const roles = experience.filter((entry) => !entry.earlierEntries?.length);
const earlier = experience.find((entry) => entry.earlierEntries?.length);
const awardMeta = (description: string) => description.split(' — ')[0];
const aboutDescription =
  '12 years turning ambiguous business problems into production systems — ERPs, AI platforms, multi-agent pipelines — across startups and enterprise, working directly with the people who use them.';
---

<BaseLayout
  title={`About — ${site.name}`}
  description={aboutDescription}
  canonicalPath="/about"
  ogType="profile"
  active="About"
  jsonLd={aboutPageJsonLd()}
>
  <main id="main-content" class="wrap">
    <section class="about-hero2">
      <div class="about-hero2-copy">
        <span class="eyebrow">About</span>
        <h1 class="about-hero2-title">{site.name}<span class="amber-dot">.</span></h1>
        <p class="about-hero2-role">{aboutRole}</p>
        <p class="about-hero2-lede">{aboutLede}</p>
        <p class="about-hero2-own">{ownershipLine}</p>
      </div>
      <figure class="about-photo">
        <img src={profileImage} alt={site.name} width="560" height="700" />
        <figcaption class="about-photo-tag">
          <b>{site.name}</b>
          <span>{heroRoles[1]}</span>
        </figcaption>
      </figure>
    </section>

    <section class="section split-section" aria-labelledby="background-heading">
      <div class="split-aside">
        <h2 id="background-heading" class="h2-sm sticky-heading">Background</h2>
      </div>
      <div class="split-main about-bio2">
        {aboutBio.map((paragraph) => <p set:html={paragraph} />)}
      </div>
    </section>

    <section class="section" aria-labelledby="capabilities-heading">
      <h2 id="capabilities-heading" class="h2-sm section-gap">What I do</h2>
      <div class="cap-grid">
        {aboutCapabilities.map((capability, index) => (
          <article class:list={['card cap-card', capability.featured && 'cap-card--featured']}>
            <span class="mono cap-n">0{index + 1}</span>
            <h3 class="cap-title">{capability.title}</h3>
            <p class="cap-body">{capability.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section journey-grid">
      <div class="journey-col" aria-labelledby="journey-heading">
        <div class="journey-head">
          <h2 id="journey-heading" class="h2-sm">Journey</h2>
          <a href="/experience" class="journey-all">Full work history →</a>
        </div>
        <div class="journey">
          {roles.map((entry) => (
            <a href={`/experience/${entry.id}`} class="journey-row journey-row--link">
              <span class="journey-who">
                <span class="journey-role journey-role--lg">{entry.company}</span>
                <span class="journey-co">{entry.role}</span>
              </span>
              <span class="journey-when">{entry.period} →</span>
            </a>
          ))}
          {earlier?.earlierEntries?.map((item) => (
            <a href={`/experience/${earlier.id}`} class="journey-row journey-row--link">
              <span class="journey-who">
                <span class="journey-role journey-role--lg">{item.company}</span>
                <span class="journey-co">{item.role.split(' · ')[0]}</span>
              </span>
              <span class="journey-when">{item.role.split(' · ').slice(-1)[0]} →</span>
            </a>
          ))}
        </div>
        <div class="about-edu">
          <h2 class="about-edu-title">Education</h2>
          <div class="journey-row journey-row--static">
            <span class="journey-who">
              <span class="journey-role journey-role--lg">{aboutEducation.degree}</span>
              <span class="journey-co">{aboutEducation.school}</span>
            </span>
            <span class="journey-when">Education</span>
          </div>
        </div>
      </div>
      <div class="journey-col" aria-labelledby="recognition-heading">
        <h2 id="recognition-heading" class="h2-sm">Recognition</h2>
        <div class="award-list">
          {awards.map((award) => (
            <div class="award-card dark-panel">
              <b>{award.title}</b>
              <span>{awardMeta(award.description)}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <StackSection id="expertise" eyebrow="" />

    <section class="depth-section" aria-labelledby="depth-heading">
      <h2 id="depth-heading" class="h3-label">Technical depth</h2>
      <dl class="depth-rows">
        {aboutDepth.map((item) => (
          <div class="depth-row">
            <dt>{item.area}</dt>
            <dd>{item.evidence}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="metric-band" aria-label="In numbers">
      {philosophyStats.map((stat) => (
        <div class="metric-cell">
          <span class="metric-value">{stat.value}</span>
          <span class="metric-label">{stat.label}</span>
        </div>
      ))}
    </section>
  </main>
</BaseLayout>
