---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import RevealScript from '@/components/RevealScript.astro';
import { site } from '@/config/site';
import { assetUrl } from '@/utils/assets';
import {
  aboutBio,
  aboutCapabilities,
  aboutSkills,
  aboutEducation,
} from '@/data/about';
import { awards } from '@/data/awards';
import { aboutPageJsonLd } from '@/utils/seo';

const profileImage = assetUrl('images/profile.jpg');
const aboutAwards = awards.slice(0, 3);
const aboutDescription =
  '14 years of turning ambiguous problems into production systems — ERPs, AI platforms, multi-agent pipelines — across startups and enterprise.';
---

<BaseLayout
  title={`About — ${site.name}`}
  description={aboutDescription}
  canonicalPath="/about"
  ogType="profile"
  jsonLd={aboutPageJsonLd()}
>
  <Nav />
  <main id="main-content">
    <section class="about-hero">
      <div class="about-hero-inner">
        <div class="about-hero-copy">
          <p class="hero-kicker" data-reveal>About</p>
          <h1 class="about-hero-title" data-reveal data-reveal-delay="1">{site.name}</h1>
          <p class="about-hero-role" data-reveal data-reveal-delay="2">
            Associate Architect · Systems Builder · Engineering Leader
          </p>
          <p class="about-hero-lede" data-reveal data-reveal-delay="3">
            14 years of turning ambiguous problems into production systems — ERPs, AI platforms,
            multi-agent pipelines — across startups and enterprise. I don't just write code; I own
            the outcome end to end.
          </p>
        </div>
        <div class="about-hero-photo" data-reveal data-reveal-delay="2">
          <div class="about-photo-ring">
            <img src={profileImage} alt={site.name} width="300" height="300" />
          </div>
        </div>
      </div>
    </section>

    <section class="about-section about-section--white">
      <div class="about-narrow">
        <h2 class="about-heading" data-reveal>Background</h2>
        {aboutBio.map((paragraph) => (
          <p class="about-body" data-reveal data-reveal-delay="1" set:html={paragraph} />
        ))}
      </div>
    </section>

    <section class="about-section about-section--cream">
      <div class="about-narrow">
        <h2 class="about-heading" data-reveal>What I do</h2>
        <div class="about-capabilities">
          {aboutCapabilities.map((capability, index) => (
            <div class="about-capability" data-reveal data-reveal-delay={String(Math.min(index, 3))}>
              <div class:list={['about-capability-icon', capability.featured && 'about-capability-icon--featured']}>
                {index === 0 && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                  </svg>
                )}
                {index === 1 && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M12 2v4m0 12v4M2 12h4m12 0h4"></path>
                  </svg>
                )}
                {index === 2 && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                )}
                {index === 3 && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="m13 2-2 14h5L9 22l2-14H6z"></path>
                  </svg>
                )}
              </div>
              <div>
                <h3 class="about-capability-title">{capability.title}</h3>
                <p class="about-capability-body">{capability.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="about-section about-section--white">
      <div class="about-narrow">
        <h2 class="about-heading" data-reveal>Technical expertise</h2>
        <div class="about-skills-grid" data-reveal data-reveal-delay="1">
          {aboutSkills.map((group) => (
            <div class="about-skill-group">
              <p class="about-skill-category">{group.category}</p>
              {group.items.map((item) => (
                <p class="about-skill-item">{item}</p>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="about-section about-section--cream">
      <div class="about-narrow">
        <div class="about-two-col" data-reveal>
          <div>
            <h2 class="about-heading">Education</h2>
            <div class="about-education">
              <p class="about-education-degree">{aboutEducation.degree}</p>
              <p class="about-education-school">{aboutEducation.school}</p>
            </div>
          </div>
          <div>
            <h2 class="about-heading">Recognition</h2>
            <div class="about-recognition-list">
              {aboutAwards.map((award) => (
                <div class="about-recognition-item">
                  <p class="about-recognition-title">{award.title}</p>
                  <p class="about-recognition-desc">{award.description.split(' — ')[0]}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="about-cta">
      <div class="about-narrow about-cta-inner">
        <h2 class="about-cta-title" data-reveal>Let's build something great.</h2>
        <p class="about-cta-lede" data-reveal data-reveal-delay="1">
          Always open to interesting problems and collaborations.
        </p>
        <div class="about-cta-actions" data-reveal data-reveal-delay="2">
          <a href={`mailto:${site.email}`} class="btn-hero-primary">Get in Touch →</a>
        </div>
        <div class="about-cta-social" data-reveal data-reveal-delay="3">
          <a href={site.medium} target="_blank" rel="noopener noreferrer" class="contact-social-link" aria-label="Medium">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff">
              <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"></path>
            </svg>
          </a>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="contact-social-link" aria-label="LinkedIn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a href={site.github} target="_blank" rel="noopener noreferrer" class="contact-social-link" aria-label="GitHub">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <RevealScript />
</BaseLayout>
