---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import { getCollection } from 'astro:content';
import { getSiteUrl } from '@/config/site';
import { assetUrl } from '@/utils/assets';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog — Siddharth Deshpande"
  description="Technical articles on AI systems, architecture patterns, and engineering leadership."
  canonicalPath="/blog"
>
  <Nav />
  <main id="main-content" class="page-container py-16">
    <h1 class="text-[clamp(28px,4vw,38px)] font-bold m-0 mb-8 tracking-tight text-ink">Blog</h1>

    {posts.length === 0 ? (
      <div class="card max-w-xl">
        <p class="text-sm font-semibold text-amber m-0 mb-2 uppercase tracking-wide">Coming soon</p>
        <p class="text-base text-muted m-0 mb-4">
          No articles yet. Add a markdown or MDX file to <code class="text-sm">src/content/blog/</code> to publish your first post.
        </p>
        <a href={getSiteUrl('/')} class="text-amber-dark font-semibold">← Back to home</a>
      </div>
    ) : (
      <ul class="list-none m-0 p-0 flex flex-col gap-4">
        {posts.map((post) => (
          <li>
            <a
              href={assetUrl(`blog/${post.slug}/`)}
              class="card block no-underline text-inherit"
            >
              <h2 class="text-xl font-bold m-0 mb-2 text-ink">{post.data.title}</h2>
              <p class="text-sm text-muted-light m-0 mb-2">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              <p class="text-sm leading-relaxed m-0 text-muted">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</BaseLayout>
