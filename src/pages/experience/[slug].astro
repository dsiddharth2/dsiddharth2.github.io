---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExperienceArticle from '@/components/ExperienceArticle.astro';
import {
  experience,
  getExperienceById,
  experienceTitle,
  experienceDescription,
} from '@/data/experience';
import { site } from '@/config/site';
import { breadcrumbJsonLd, experienceJsonLd } from '@/utils/seo';
import { neighbours } from '@/utils/neighbours';

export function getStaticPaths() {
  return experience.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;
const entry = getExperienceById(slug!);

if (!entry) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const pagePath = `/experience/${entry.id}`;
const title = experienceTitle(entry);
const fullDescription = experienceDescription(entry);
const description =
  fullDescription.length > 160 ? `${fullDescription.slice(0, 157).trimEnd()}...` : fullDescription;
const { prev, next } = neighbours(experience, entry);
---

<BaseLayout
  title={`${title} — ${site.name}`}
  description={description}
  canonicalPath={pagePath}
  markdownPath={`${pagePath}.md`}
  ogType="article"
  active="Experience"
  jsonLd={[
    experienceJsonLd(entry),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Experience', path: '/experience' },
      { name: entry.company, path: pagePath },
    ]),
  ]}
>
  <main id="main-content" class="wrap detail-page">
    <a href="/experience" class="back-link">← Back to Experience</a>
    <ExperienceArticle entry={entry} headingLevel="h1" />
    <nav class="prev-next" aria-label="More experience">
      <a href={`/experience/${prev.id}`}><span>← Previous</span><b>{prev.company}</b></a>
      <a href={`/experience/${next.id}`}><span>Next →</span><b>{next.company}</b></a>
    </nav>
  </main>
</BaseLayout>
