---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExperienceArticle from '@/components/ExperienceArticle.astro';
import { experience, experienceTitle } from '@/data/experience';
import { aboutEducation } from '@/data/about';
import { site } from '@/config/site';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/utils/seo';

const description =
  '12 years shipping production systems — from a training institute and 0-to-1 products through logistics ERP and an AI platform serving 300+ facilities.';
---

<BaseLayout
  title={`Experience — ${site.name}`}
  description={description}
  canonicalPath="/experience"
  markdownPath="/experience.md"
  active="Experience"
  jsonLd={[
    collectionPageJsonLd({
      name: `Experience — ${site.name}`,
      path: '/experience',
      description,
      items: experience.map((entry) => ({
        name: experienceTitle(entry),
        path: `/experience/${entry.id}`,
      })),
    }),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Experience', path: '/experience' },
    ]),
  ]}
>
  <main id="main-content" class="wrap">
    <section class="page-hero">
      <div class="page-hero-copy">
        <span class="eyebrow">Experience</span>
        <h1 class="page-title">Where I've made an <em class="acc-em">impact.</em></h1>
      </div>
      <div class="exp-hero-aside">
        <p class="page-hero-aside">{description}</p>
        <nav class="chip-row" aria-label="Jump to a role">
          {experience.map((entry) => (
            <a href={`#${entry.id}`} class="jump-pill">{entry.company}</a>
          ))}
        </nav>
      </div>
    </section>

    <div class="exp-list">
      {experience.map((entry) => (
        <ExperienceArticle entry={entry} showPermalink>
          {entry.earlierEntries && (
            <div slot="after-earlier" class="exp-edu">
              <b>{aboutEducation.degree}</b>
              <span>{aboutEducation.school}</span>
            </div>
          )}
        </ExperienceArticle>
      ))}
    </div>
  </main>
</BaseLayout>
