---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import ContactSection from '@/components/ContactSection.astro';
import RevealScript from '@/components/RevealScript.astro';
import { walkthrough, walkthroughIntro, walkthroughChanges } from '@/data/walkthrough';
import { getProductBySlug } from '@/data/products';
import { site } from '@/config/site';
import { breadcrumbJsonLd } from '@/utils/seo';

const description =
  'One system from the first conversation to production: what was actually asked for, the first version that did not work, where the security decision was, and what I would change.';

const product = getProductBySlug('multi-agent')!;

const constraints = [
  'Confidential client environments, with employer and product names withheld under NDA.',
  'Multi-tenant permission rewriting applied to generated SQL, so a natural-language query can never read across a tenant boundary.',
  'A 4 TB production operations database queried live, with read-only validation on everything generated.',
  'A DigitalOcean to AWS migration completed in 3 months, following a security incident, while the business kept running.',
  'Zero-downtime scaling from hundreds to 2,500 daily users on a system finance and operations depended on all day.',
  '20K unstructured support documents with no clean schema and author-dependent terminology.',
  'Nightly analysis that has to cost a small fraction of the spend it is there to reduce.',
];
---

<BaseLayout
  title={`How I Work — ${site.name}`}
  description={description}
  canonicalPath="/how-i-work"
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'How I Work', path: '/how-i-work' },
  ])}
>
  <Nav />
  <main id="main-content">
    <section class="about-hero about-hero--cream">
      <div class="about-hero-inner">
        <div class="about-hero-copy">
          <p class="hero-kicker" data-reveal>How I Work</p>
          <h1 class="about-hero-title" data-reveal data-reveal-delay="1">
            One system, end to end
          </h1>
          <p class="about-hero-lede" data-reveal data-reveal-delay="2">
            {walkthroughIntro}
          </p>
        </div>
      </div>
    </section>

    <section class="about-section about-section--white">
      <div class="walk-container">
        <div class="walk-meta" data-reveal>
          <p class="walk-meta-name">{product.title}</p>
          <p class="walk-meta-sub">{product.company} · {product.stack.slice(0, 4).join(' · ')}</p>
        </div>

        {walkthrough.map((section) => (
          <article class="walk-section" data-reveal>
            <h2 class="walk-heading">{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p class="walk-body">{paragraph}</p>
            ))}
          </article>
        ))}

        <article class="walk-section" data-reveal>
          <h2 class="walk-heading">What I would change</h2>
          <dl class="walk-changes">
            {walkthroughChanges.map((change) => (
              <div class="walk-change">
                <dt class="walk-change-title">{change.title}</dt>
                <dd class="walk-change-detail">{change.detail}</dd>
              </div>
            ))}
          </dl>
        </article>

        <div class="walk-outro" data-reveal>
          <p class="walk-body">
            The architecture diagram, the full decision list and the rest of the stack are on the
            case study. Four other systems are written up the same way.
          </p>
          <div class="walk-links">
            <a href="/projects/multi-agent" class="walk-link">
              Read the full case study
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="M12 5l7 7-7 7"></path>
              </svg>
            </a>
            <a href="/projects" class="walk-link">
              All case studies
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="M12 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="about-section about-section--cream">
      <div class="walk-container">
        <h2 class="about-heading" data-reveal>Constraints I've worked under</h2>
        <ul class="constraint-list" data-reveal data-reveal-delay="1">
          {constraints.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </section>

    <ContactSection />
  </main>
  <RevealScript />
</BaseLayout>
