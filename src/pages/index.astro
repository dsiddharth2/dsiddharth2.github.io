---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/Hero.astro';
import ImpactHighlights from '@/components/ImpactHighlights.astro';
import WhatIBuild from '@/components/WhatIBuild.astro';
import CaseStudiesSection from '@/components/CaseStudiesSection.astro';
import ExperienceSection from '@/components/ExperienceSection.astro';
import OpenSourceSection from '@/components/OpenSourceSection.astro';
import ContactSection from '@/components/ContactSection.astro';
import RevealScript from '@/components/RevealScript.astro';
import { personJsonLd, websiteJsonLd } from '@/utils/seo';
---

<BaseLayout
  canonicalPath="/"
  ogType="profile"
  jsonLd={[websiteJsonLd(), personJsonLd()]}
>
  <Nav />
  <button
    type="button"
    data-theme-toggle
    style="position:fixed;right:16px;bottom:16px;z-index:60;width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer"
  >☾</button>
  <main id="main-content">
    <Hero />
    <ImpactHighlights />
    <WhatIBuild />
    <CaseStudiesSection />
    <ExperienceSection compact limit={3} />
    <OpenSourceSection compact limit={2} />
    <ContactSection />
  </main>
  <RevealScript />
</BaseLayout>
