---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/Hero.astro';
import ImpactHighlights from '@/components/ImpactHighlights.astro';
import PhilosophySection from '@/components/PhilosophySection.astro';
import ExperienceSection from '@/components/ExperienceSection.astro';
import ProductsSection from '@/components/ProductsSection.astro';
import OpenSourceSection from '@/components/OpenSourceSection.astro';
import RecognitionSection from '@/components/RecognitionSection.astro';
import ContactSection from '@/components/ContactSection.astro';
import RevealScript from '@/components/RevealScript.astro';
import { personJsonLd, websiteJsonLd } from '@/utils/seo';
---

<BaseLayout
  canonicalPath="/"
  ogType="profile"
  jsonLd={[websiteJsonLd(), personJsonLd()]}
>
  <Nav />
  <main id="main-content">
    <Hero />
    <ImpactHighlights />
    <PhilosophySection />
    <ExperienceSection />
    <ProductsSection />
    <OpenSourceSection />
    <RecognitionSection />
    <ContactSection />
  </main>
  <RevealScript />
</BaseLayout>
