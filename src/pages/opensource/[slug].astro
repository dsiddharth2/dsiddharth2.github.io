---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SplitDetailPage from '@/components/SplitDetailPage.astro';
import { openSourceProjects, getOpenSourceBySlug, openSourceSeoDescription } from '@/data/opensource';
import { site } from '@/config/site';
import { breadcrumbJsonLd, openSourceJsonLd } from '@/utils/seo';

export function getStaticPaths() {
  return openSourceProjects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getOpenSourceBySlug(slug!);

if (!project) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const projectPath = `/opensource/${project.slug}`;
const description = openSourceSeoDescription(project);
const links = [
  { label: 'GitHub', href: project.url },
  ...(project.packagist ? [{ label: 'Packagist', href: project.packagist }] : []),
  ...(project.npmUrl ? [{ label: 'npm', href: project.npmUrl }] : []),
  ...(project.vaultUrl ? [{ label: 'Vault', href: project.vaultUrl }] : []),
  ...(project.dockerHub ? [{ label: 'Docker Hub', href: project.dockerHub }] : []),
  ...(project.demoUrl ? [{ label: 'Demos', href: project.demoUrl }] : []),
];
---

<BaseLayout
  title={`${project.title} — ${site.name}`}
  description={description}
  canonicalPath={projectPath}
  markdownPath={`${projectPath}.md`}
  ogType="article"
  jsonLd={[
    openSourceJsonLd(project),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Open Source', path: '/opensource' },
      { name: project.title, path: projectPath },
    ]),
  ]}
>
  <SplitDetailPage
    backHref="/opensource"
    title={project.title}
    subtitle={project.subtitle}
    tagline={project.tagline}
    stack={project.tags}
    note={`${project.language} · MIT`}
    links={links}
    overview={project.overview}
    metrics={project.stats}
    architectureSvg={project.architectureSvg}
    architectureAlt={`${project.title} architecture`}
    howItWorks={project.howItWorks}
    decisions={project.decisions}
    evaluation={project.evaluation}
    reflections={project.reflections}
  />
</BaseLayout>
