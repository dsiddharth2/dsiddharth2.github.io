---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import OpenSourceIcon from '@/components/ui/OpenSourceIcon.astro';
import RevealScript from '@/components/RevealScript.astro';
import { openSourceProjects, getOpenSourceBySlug } from '@/data/opensource';
import { site } from '@/config/site';
import { breadcrumbJsonLd, openSourceJsonLd } from '@/utils/seo';

export function getStaticPaths() {
  return openSourceProjects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getOpenSourceBySlug(slug!);

if (!project) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const projectPath = `/opensource/${project.slug}`;
const description =
  project.fullDescription.length > 160
    ? `${project.fullDescription.slice(0, 157).trimEnd()}...`
    : project.fullDescription;
---

<BaseLayout
  title={`${project.title} — ${site.name}`}
  description={description}
  canonicalPath={projectPath}
  markdownPath={`${projectPath}.md`}
  ogType="article"
  jsonLd={[
    openSourceJsonLd(project),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Open Source', path: '/opensource' },
      { name: project.title, path: projectPath },
    ]),
  ]}
>
  <Nav />
  <main id="main-content" class="oss-detail">
    <div class="oss-detail-bar">
      <div class="oss-detail-bar-inner">
        <a href="/opensource" class="oss-back-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
          </svg>
          Back to Open Source
        </a>
        <span class="oss-detail-lang">{project.language}</span>
      </div>
    </div>

    <section class="oss-detail-hero">
      <div class="page-container oss-detail-hero-inner">
        <div class="oss-detail-icon" data-reveal>
          <OpenSourceIcon icon={project.icon} />
        </div>
        <h1 class="oss-detail-title" data-reveal data-reveal-delay="1">{project.title}</h1>
        <p class="oss-detail-subtitle" data-reveal data-reveal-delay="2">{project.subtitle}</p>
        <p class="oss-detail-lede" data-reveal data-reveal-delay="3">{project.fullDescription}</p>
      </div>
    </section>

    <section class="oss-detail-impact" aria-label="Project stats">
      <div class="page-container">
        <div class="oss-impact-grid" style={`--impact-cols: ${project.stats.length}`}>
          {project.stats.map((item, index) => (
            <div class="oss-impact-item" data-reveal data-reveal-delay={String(Math.min(index, 3))}>
              <p class="oss-impact-metric">{item.metric}</p>
              <p class="oss-impact-label">{item.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="oss-detail-body">
      <div class="page-container oss-detail-body-inner">
        <div class="oss-detail-main" data-reveal>
          <p class="section-eyebrow">How it works</p>
          <h2 class="oss-detail-heading">What's inside</h2>
          <div class="oss-highlight-list">
            {project.highlights.map((item, index) => (
              <div class="oss-highlight-item">
                <span class="oss-highlight-index">{String(index + 1).padStart(2, '0')}</span>
                <p>{item}</p>
              </div>
            ))}
          </div>
        </div>

        <aside class="oss-detail-sidebar" data-reveal data-reveal-delay="1">
          <p class="section-eyebrow">Tech Stack</p>
          <div class="oss-stack-list">
            {project.tags.map((tag) => (
              <div class="oss-stack-item">{tag}</div>
            ))}
          </div>
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="oss-github-cta">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
            View on GitHub
            <span class="sr-only">(opens in a new tab)</span>
          </a>
          {project.packagist && (
            <a href={project.packagist} target="_blank" rel="noopener noreferrer" class="oss-packagist-link">
              Packagist
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          )}
        </aside>
      </div>
    </section>
  </main>
  <RevealScript />
</BaseLayout>
