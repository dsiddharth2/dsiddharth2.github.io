---
import BaseLayout from '@/layouts/BaseLayout.astro';
import OssDetail from '@/components/OssDetail.astro';
import { openSourceProjects, getOpenSourceBySlug, openSourceSeoDescription } from '@/data/opensource';
import { site } from '@/config/site';
import { breadcrumbJsonLd, openSourceJsonLd } from '@/utils/seo';

export function getStaticPaths() {
  return openSourceProjects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getOpenSourceBySlug(slug!);

if (!project) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const projectPath = `/opensource/${project.slug}`;
const description = openSourceSeoDescription(project);
---

<BaseLayout
  title={`${project.title} — ${site.name}`}
  description={description}
  canonicalPath={projectPath}
  markdownPath={`${projectPath}.md`}
  ogType="article"
  active="Open Source"
  jsonLd={[
    openSourceJsonLd(project),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Open Source', path: '/opensource' },
      { name: project.title, path: projectPath },
    ]),
  ]}
>
  <main id="main-content">
    <OssDetail project={project} />
  </main>
</BaseLayout>
