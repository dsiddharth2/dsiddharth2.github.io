---
import BaseLayout from '@/layouts/BaseLayout.astro';
import OssCard from '@/components/OssCard.astro';
import { openSourceProjects, externalContributions } from '@/data/opensource';
import { site } from '@/config/site';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/utils/seo';

const description =
  'Tools I build in public — agent kits, package managers, review pipelines, libraries, and UI plugins other engineers actually use.';
---

<BaseLayout
  title={`Open Source — ${site.name}`}
  description={description}
  canonicalPath="/opensource"
  markdownPath="/opensource.md"
  active="Open Source"
  jsonLd={[
    collectionPageJsonLd({
      name: `Open Source — ${site.name}`,
      path: '/opensource',
      description,
      items: openSourceProjects.map((project) => ({
        name: project.title,
        path: `/opensource/${project.slug}`,
      })),
    }),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Open Source', path: '/opensource' },
    ]),
  ]}
>
  <main id="main-content" class="wrap">
    <section class="page-hero">
      <div class="page-hero-copy">
        <span class="eyebrow">Open Source</span>
        <h1 class="page-title">Giving back to the <em class="acc-em">community</em></h1>
      </div>
      <div class="exp-hero-aside">
        <p class="page-hero-aside">{description}</p>
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="oss-gh-link">
          github.com/dsiddharth2 ↗<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </section>

    <section class="oss-list" aria-label="Open source projects">
      <div class="oss-grid">
        {openSourceProjects.map((project, index) => (
          <OssCard project={project} index={index} showTags headingLevel="h2" />
        ))}
      </div>
    </section>

    {externalContributions.length > 0 && (
      <section class="section contrib" aria-labelledby="contrib-heading">
        <h2 id="contrib-heading" class="list-heading">Contributions to other people's codebases</h2>
        <div class="contrib-grid">
          {externalContributions.map((item) => (
            <article class="card contrib-card">
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="contrib-repo">
                {item.repo}<span class="sr-only"> (opens in a new tab)</span>
              </a>
              <dl class="case-card2-facts">
                <div><dt>Problem</dt><dd>{item.problem}</dd></div>
                <div><dt>What I changed</dt><dd>{item.contribution}</dd></div>
                <div><dt>Approach</dt><dd>{item.approach}</dd></div>
                <div class="is-accent"><dt>Result</dt><dd>{item.result}</dd></div>
              </dl>
              {item.prUrl && (
                <a href={item.prUrl} target="_blank" rel="noopener noreferrer">
                  View the pull request<span class="sr-only"> (opens in a new tab)</span>
                </a>
              )}
            </article>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>
