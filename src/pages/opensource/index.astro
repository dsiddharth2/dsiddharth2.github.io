---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import OpenSourceSection from '@/components/OpenSourceSection.astro';
import RevealScript from '@/components/RevealScript.astro';
import { openSourceProjects } from '@/data/opensource';
import { site } from '@/config/site';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/utils/seo';

const description =
  'Tools I build in public — package managers, review pipelines, libraries, and UI plugins other engineers actually use.';
---

<BaseLayout
  title={`Open Source — ${site.name}`}
  description={description}
  canonicalPath="/opensource"
  markdownPath="/opensource.md"
  jsonLd={[
    collectionPageJsonLd({
      name: `Open Source — ${site.name}`,
      path: '/opensource',
      description,
      items: openSourceProjects.map((project) => ({
        name: project.title,
        path: `/opensource/${project.slug}`,
      })),
    }),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Open Source', path: '/opensource' },
    ]),
  ]}
>
  <Nav />
  <main id="main-content">
    <section class="about-hero about-hero--cream">
      <div class="about-hero-inner">
        <div class="about-hero-copy">
          <p class="hero-kicker" data-reveal>Open Source</p>
          <h1 class="about-hero-title" data-reveal data-reveal-delay="1">
            Giving back to the community
          </h1>
          <p class="about-hero-lede" data-reveal data-reveal-delay="2">
            {description}
          </p>
        </div>
      </div>
    </section>

    <OpenSourceSection hideIntro />

    <section class="about-cta">
      <div class="about-narrow about-cta-inner">
        <h2 class="about-cta-title" data-reveal>Let's build something great.</h2>
        <p class="about-cta-lede" data-reveal data-reveal-delay="1">
          Always open to interesting problems and collaborations.
        </p>
        <div class="about-cta-actions" data-reveal data-reveal-delay="2">
          <a href={`mailto:${site.email}`} class="btn-hero-primary">Get in Touch →</a>
        </div>
      </div>
    </section>
  </main>
  <RevealScript />
</BaseLayout>
