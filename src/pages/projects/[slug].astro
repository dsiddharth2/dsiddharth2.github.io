---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SplitDetailPage from '@/components/SplitDetailPage.astro';
import { products, getProductBySlug, productSeoDescription } from '@/data/products';
import { site } from '@/config/site';
import { breadcrumbJsonLd, projectJsonLd } from '@/utils/seo';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug!);

if (!product) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const projectPath = `/projects/${product.slug}`;
const description = productSeoDescription(product);
---

<BaseLayout
  title={`${product.title} — ${site.name}`}
  description={description}
  canonicalPath={projectPath}
  markdownPath={`${projectPath}.md`}
  ogType="article"
  jsonLd={[
    projectJsonLd(product),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Products', path: '/projects' },
      { name: product.title, path: projectPath },
    ]),
  ]}
>
  <SplitDetailPage
    backHref="/projects"
    title={product.title}
    subtitle={product.subtitle}
    tagline={product.tagline}
    stack={product.stack}
    note={product.confidentialNote || `Built at ${product.company}`}
    noteItalic={Boolean(product.confidentialNote)}
    overview={product.overview}
    metrics={product.impact}
    architectureSvg={product.architectureSvg}
    architectureAlt={`${product.title} architecture`}
    howItWorks={product.howItWorks}
    decisions={product.decisions}
    evaluation={product.evaluation}
    reflections={product.reflections}
  />
</BaseLayout>
