---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectDetail from '@/components/ProjectDetail.astro';
import { products, getProductBySlug, productSeoDescription } from '@/data/products';
import { site } from '@/config/site';
import { breadcrumbJsonLd, projectJsonLd } from '@/utils/seo';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug!);

if (!product) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const projectPath = `/projects/${product.slug}`;
const description = productSeoDescription(product);
---

<BaseLayout
  title={`${product.title} — ${site.name}`}
  description={description}
  canonicalPath={projectPath}
  markdownPath={`${projectPath}.md`}
  ogType="article"
  active="Work"
  jsonLd={[
    projectJsonLd(product),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Case Studies', path: '/projects' },
      { name: product.title, path: projectPath },
    ]),
  ]}
>
  <main id="main-content">
    <ProjectDetail product={product} />
  </main>
</BaseLayout>
