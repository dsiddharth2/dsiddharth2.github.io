---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { products } from '@/data/products';
import { resolvedCaseStudies } from '@/data/caseStudies';
import { heroBadge } from '@/data/hero';
import { workCards, workFilters } from '@/data/workMeta';
import { site } from '@/config/site';
import { countForFilter } from '@/utils/workFilter';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/utils/seo';

const description =
  'Production systems across knowledge graphs, multi-agent AI, FinOps, search, logistics, and analytics — from 0-to-1 through enterprise scale.';
const studies = resolvedCaseStudies();
const heroStats = [
  { value: String(products.length), label: 'production systems' },
  { value: String(studies.length), label: 'in-depth case studies' },
  { value: heroBadge.value, label: heroBadge.label },
];
const cards = workCards();
const filters = workFilters.map((label) => ({ label, count: countForFilter(cards, label) }));
---

<BaseLayout
  title={`Case Studies — ${site.name}`}
  description={description}
  canonicalPath="/projects"
  markdownPath="/projects.md"
  active="Work"
  jsonLd={[
    collectionPageJsonLd({
      name: `Case Studies — ${site.name}`,
      path: '/projects',
      description,
      items: products.map((product) => ({
        name: product.title,
        path: `/projects/${product.slug}`,
      })),
    }),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Case Studies', path: '/projects' },
    ]),
  ]}
>
  <main id="main-content" class="wrap">
    <section class="work-hero">
      <div class="page-hero-copy">
        <span class="eyebrow">Case Studies</span>
        <h1 class="page-title work-hero-title">Systems I architected and <em class="acc-em">shipped.</em></h1>
      </div>
      <p class="work-hero-lede">{description}</p>
      <dl class="work-hero-stats">
        {heroStats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="case-list" aria-labelledby="cases-heading">
      <h2 id="cases-heading" class="list-heading">Case studies</h2>
      {studies.map((study) => (
        <a href={study.href} class="case-card2">
          <div class="case-card2-copy">
            <span class="mono">#{study.domain}</span>
            <h3 class="case-card2-title">{study.product.title}</h3>
            <p class="case-card2-summary">{study.product.tagline}</p>
            <dl class="case-card2-facts">
              <div><dt>Problem</dt><dd>{study.problem}</dd></div>
              {study.constraint && <div><dt>Hardest constraint</dt><dd>{study.constraint}</dd></div>}
              <div><dt>Approach</dt><dd>{study.approach}</dd></div>
              {study.decision && <div class="is-accent"><dt>Key decision</dt><dd>{study.decision}</dd></div>}
            </dl>
            <span class="case-card2-cta">Read the case study →</span>
          </div>
          <dl class="case-card2-panel">
            {study.product.impact.map((item) => (
              <div class="case-card2-stat">
                <dt class="case-card2-label">{item.label}</dt>
                <dd class="case-card2-metric">{item.metric}</dd>
              </div>
            ))}
          </dl>
        </a>
      ))}
    </section>

    <section id="systems" class="section systems" aria-labelledby="systems-heading">
      <div class="systems-head">
        <h2 id="systems-heading" class="list-heading">All systems</h2>
      </div>
      <div class="work-toolbar" data-work-filter>
        <div class="chip-row" role="group" aria-label="Filter systems">
          {filters.map((filter, index) => (
            <button
              type="button"
              class="filter-pill"
              data-filter={filter.label}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >{filter.label} · {filter.count}</button>
          ))}
        </div>
        <span class="mono" aria-live="polite" data-work-count>Showing {cards.length} of {cards.length} systems</span>
      </div>
      <div class="oss-grid">
        {products.map((product, index) => (
          <a
            href={`/projects/${product.slug}`}
            class="card system-card"
            data-work-card
            data-slug={cards[index].slug}
            data-categories={JSON.stringify(cards[index].categories)}
            data-case={String(cards[index].isCase)}
          >
            <div class="system-card-top">
              <span class="mono">{String(index + 1).padStart(2, '0')} · {product.company}</span>
              <span class="system-card-metric">{product.impact[0].metric}</span>
            </div>
            <h3 class="system-card-title">{product.title}</h3>
            <span class="system-card-sub">{product.subtitle}</span>
            <p class="system-card-desc">{product.description}</p>
            <div class="chip-row">
              {product.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { matchesWorkFilter } from '@/utils/workFilter';

  const root = document.querySelector<HTMLElement>('#systems');
  if (root) {
    const pills = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-work-card]')];
    const count = root.querySelector<HTMLElement>('[data-work-count]');

    const apply = (filter: string) => {
      let shown = 0;
      for (const card of cards) {
        const visible = matchesWorkFilter(
          {
            slug: card.dataset.slug ?? '',
            categories: JSON.parse(card.dataset.categories ?? '[]'),
            isCase: card.dataset.case === 'true',
          },
          filter,
        );
        card.hidden = !visible;
        if (visible) shown += 1;
      }
      pills.forEach((pill) => pill.setAttribute('aria-pressed', String(pill.dataset.filter === filter)));
      if (count) count.textContent = `Showing ${shown} of ${cards.length} systems`;
    };

    pills.forEach((pill) => pill.addEventListener('click', () => apply(pill.dataset.filter ?? 'All')));
  }
</script>
