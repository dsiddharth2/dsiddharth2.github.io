---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { products } from '@/data/products';
import { resolvedCaseStudies } from '@/data/caseStudies';
import { site } from '@/config/site';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/utils/seo';

const description =
  'Production systems across knowledge graphs, multi-agent AI, FinOps, search, logistics, and analytics — from 0-to-1 through enterprise scale.';
const studies = resolvedCaseStudies();
---

<BaseLayout
  title={`Case Studies — ${site.name}`}
  description={description}
  canonicalPath="/projects"
  markdownPath="/projects.md"
  active="Work"
  jsonLd={[
    collectionPageJsonLd({
      name: `Case Studies — ${site.name}`,
      path: '/projects',
      description,
      items: products.map((product) => ({
        name: product.title,
        path: `/projects/${product.slug}`,
      })),
    }),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Case Studies', path: '/projects' },
    ]),
  ]}
>
  <main id="main-content" class="wrap">
    <section class="page-hero">
      <div class="page-hero-copy">
        <span class="eyebrow">Case Studies</span>
        <h1 class="page-title">Systems I architected and <em class="acc-em">shipped.</em></h1>
      </div>
      <p class="page-hero-aside">{description}</p>
    </section>

    <section class="case-list" aria-labelledby="cases-heading">
      <h2 id="cases-heading" class="list-heading">Case studies</h2>
      {studies.map((study) => (
        <a href={study.href} class="case-card2">
          <div class="case-card2-copy">
            <span class="mono">#{study.domain}</span>
            <h3 class="case-card2-title">{study.product.title}</h3>
            <p class="case-card2-summary">{study.product.tagline}</p>
            <dl class="case-card2-facts">
              <div><dt>Problem</dt><dd>{study.problem}</dd></div>
              {study.constraint && <div><dt>Hardest constraint</dt><dd>{study.constraint}</dd></div>}
              <div><dt>Approach</dt><dd>{study.approach}</dd></div>
              {study.decision && <div class="is-accent"><dt>Key decision</dt><dd>{study.decision}</dd></div>}
            </dl>
            <span class="case-card2-cta">Read the case study →</span>
          </div>
          <div class="case-card2-panel">
            <span class="case-card2-metric">{study.outcome.metric}</span>
            <span class="case-card2-label">{study.outcome.label}</span>
          </div>
        </a>
      ))}
    </section>

    <section class="section systems" aria-labelledby="systems-heading">
      <div class="systems-head">
        <h2 id="systems-heading" class="list-heading">All systems</h2>
        <span class="mono">{products.length} production systems</span>
      </div>
      <div class="oss-grid">
        {products.map((product, index) => (
          <a href={`/projects/${product.slug}`} class="card system-card">
            <div class="system-card-top">
              <span class="mono">{String(index + 1).padStart(2, '0')} · {product.company}</span>
              <span class="system-card-metric">{product.impact[0].metric}</span>
            </div>
            <h3 class="system-card-title">{product.title}</h3>
            <span class="system-card-sub">{product.subtitle}</span>
            <p class="system-card-desc">{product.description}</p>
            <div class="chip-row">
              {product.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
